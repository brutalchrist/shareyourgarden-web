# Base URL of the ShareYourGarden backend API.
# Production: https://shareyourgarden-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:1337

# OAuth 2.0 Web client ID from Google Cloud Console (not secret).
# Must match GOOGLE_CLIENT_ID in the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional, for development: "lat,lng" the map opens on, standing in for the
# visitor's approximate position from `/api/geo`, which only exists on
# Netlify (or `netlify dev`). Example: Santiago, Chile.
# NEXT_PUBLIC_DEV_CENTER=-33.45,-70.66
